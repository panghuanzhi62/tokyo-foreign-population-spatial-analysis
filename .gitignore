# =====================================================================
# Tokyo-China data-acquisition safety (added round02; public-repo guard)
# Strengthens the boundary so future raw data, full text, credentials,
# and large files are never accidentally committed. Additive only -
# already-tracked files (matrix CSVs, metadata control CSVs, reports)
# stay tracked; git does not untrack files via .gitignore.
# Keep outputs/claude_reports/ TRACKED (not listed below).
# =====================================================================

# A. Local raw and processed data
data/
data_raw/
data_processed/
data_interim/
data_external/
local_data/
downloads/
tmp_downloads/
scratch/
cache/

# B. Literature and full-text safety
ref/
refs/
fulltext/
full_text/
local_fulltext/
literature_fulltext/
*.pdf

# C. Office / manuscript safety
*.docx
*.doc
*.pptx
*.ppt
~$*
TokyoProject.docx

